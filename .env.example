# Скопируйте этот файл в .env и заполните значения

PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=замените-на-длинную-случайную-строку

# ---- SQL Server (то, к чему вы подключаетесь в SSMS 22) ----
# Для экземпляра по умолчанию: DB_SERVER=localhost, DB_INSTANCE пусто
# Для SQL Express: DB_SERVER=localhost, DB_INSTANCE=SQLEXPRESS
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
# Порт указывайте, только если задали фиксированный TCP-порт (тогда DB_INSTANCE оставьте пустым)
DB_PORT=
DB_NAME=FoodZero
DB_USER=foodzero_app
DB_PASSWORD="FoodZero_Strong#2026"
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Вход через Google (console.cloud.google.com → APIs & Services → Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
