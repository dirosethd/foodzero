<%- include('partials/header') %>

<section class="page-hero page-hero-sm">
  <div class="container profile-head">
    <% if (user.AvatarUrl) { %>
      <img class="avatar" src="<%= user.AvatarUrl %>" alt="" referrerpolicy="no-referrer">
    <% } else { %>
      <div class="avatar avatar-letter"><%= user.Name.charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <h1><%= user.Name %></h1>
      <p><%= user.Email %> ·
        <%= user.GoogleId ? 'Google' : '' %><%= user.GoogleId && user.HasPassword ? ' + ' : '' %><%= user.HasPassword ? 'email & password' : '' %>
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row-between">
      <h2>My reservations</h2>
      <a href="/reservation" class="btn btn-dark btn-sm">New reservation</a>
    </div>
    <% if (!reservations.length) { %>
      <p class="muted">You have no reservations yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Date</th><th>Time</th><th>Guests</th><th>Phone</th><th>Comment</th></tr></thead>
          <tbody>
          <% reservations.forEach(function (r) { const d = new Date(r.ReservedAt); %>
            <tr>
              <td><%= d.toLocaleDateString('ru-RU') %></td>
              <td><%= d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= r.Guests %></td>
              <td><%= r.Phone %></td>
              <td><%= r.Comment || '—' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
